profile "esld/1.0";
voltsys LV = {
  nominal = 230V;
  phases = 1ph;
  frequency = 50Hz;
};
grid GRID : grid {
  vs = LV;
}
lighting L1 : lighting {
  kw = 0.1kW;
}
lighting L2 : lighting {
  kw = 0.1kW;
}
lighting L3 : lighting {
  kw = 0.1kW;
}
lighting L4 : lighting {
  kw = 0.1kW;
}
lighting L5 : lighting {
  kw = 0.1kW;
}
lighting L6 : lighting {
  kw = 0.1kW;
}
board MAIN : board {
  vs = LV;
  incomers = [GRID.out];
  busbar_rating_a = 100A;
  circuit LIGHTS {
    protection : mcb {
      rating_a = 10A;
    };
    loads = [L1, L2, L3, L4, L5, L6];
  };
}
connect GRID.out -> MAIN.in;
