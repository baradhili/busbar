profile "esld/1.0";

voltsys LV = { nominal = 230V; phases = 1ph; frequency = 50Hz; neutral = yes; earthing = "TN-C-S"; };
voltsys DC_PV = { nominal = 400V; phases = dc; neutral = no; earthing = isolated; };

code "AS/NZS 3000:2018" {
  rcd_socket_circuits     = 30mA;
  rcd_lighting_circuits   = 30mA;
  max_final_circuit_a     = 32A;
  spd_required            = yes;
  neutral_earth_bond      = "MEN at main switchboard only";
}

// ---------- Sources & Generation ----------
// L12 in JSON is the grid source
grid GRID : grid { vs = LV; supply_a = 100A; fault_mva = 10MVA; export_allowed = yes; }
pv_array PV1 : pv_array { kw_peak = 5.0kW; strings = 2; voc = 400V; isc = 10A; }
inverter INV1 : inverter {
  kind = "string"; kw = 5.0kW; vs = LV;
  island_capable = yes; export_limit = 5kW; transfer_ms = 20ms;
}

// ---------- Earthing ----------
earth MAIN_EARTH : earth { electrode = "rod"; ohm = 10ohm; }

// ---------- Main Board (Shed) ----------
board SHED_MAIN : board {
  vs = LV;
  bus B2 { incomers = [GRID.out]; rating_a = 100A; }
  ways = 6;

  fuse FU1 : fuse { rating_a = 100A; breaking_ka = 10kA; class = "gG"; }
  meter EM1 : meter { kind = utility; accuracy = "1.0"; }
  main_switch QF4 : main_switch { rating_a = 100A; poles = 2; lockable = yes; }
  spd SPD1 : spd { spd_type = 2; in_ka = 10kA; }

  circuit SHED_LOAD {
    protection : breaker { rating_a = 40A; breaking_ka = 10kA; technology = mccb; };
    loads      = [SHED_MISC];
  }

  circuit HOUSE_FEED {
    protection : breaker { rating_a = 100A; breaking_ka = 10kA; technology = mccb; };
    cable      = { csa = 16mm2; cores = 4; length = 25m; method = "underground"; };
  }
}

connect GRID.out -> SHED_MAIN.FU1.in;
connect SHED_MAIN.FU1.out -> SHED_MAIN.EM1.in;
connect SHED_MAIN.EM1.out -> SHED_MAIN.QF4.in;
connect SHED_MAIN.QF4.out -> SHED_MAIN.B2;
connect SHED_MAIN.pe -- MAIN_EARTH.e;
connect SHED_MAIN.HOUSE_FEED.out -> HOUSE_SUB.QS1.in;

// ---------- House Sub-board ----------
board HOUSE_SUB : board {
  vs = LV;
  incomers = [SHED_MAIN.HOUSE_FEED.out];
  busbar_rating_a = 100A;
  ways = 24;

  main_switch QS1 : main_switch { rating_a = 100A; poles = 2; }
  spd SPD2 : spd { spd_type = 2; in_ka = 10kA; }

  circuit LIGHTS_NTH {
    protection : rcbo { rating_a = 10A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [LIGHTS_NTH_LOAD];
  }
  circuit LIGHTS_STH {
    protection : rcbo { rating_a = 10A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [LIGHTS_STH_LOAD];
  }
  circuit LIGHTS_EXT {
    protection : rcbo { rating_a = 10A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [LIGHTS_EXT_LOAD];
  }
  circuit SOCKETS_STH {
    protection : rcbo { rating_a = 20A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [SOCKETS_STH_LOAD];
  }
  circuit SOCKETS_NTH {
    protection : rcbo { rating_a = 20A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [SOCKETS_NTH_LOAD];
  }
  circuit SOCKETS_KIT {
    protection : rcbo { rating_a = 20A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [SOCKETS_KIT_LOAD];
  }
  circuit SOCKETS_FAN {
    protection : rcbo { rating_a = 10A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [SOCKETS_FAN_LOAD];
  }
  circuit LAUNDRY {
    protection : rcbo { rating_a = 20A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [WASHER, DRYER];
  }
  circuit KIT_STOVE_DISH {
    protection : rcbo { rating_a = 32A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [STOVE, DISHWASHER];
  }
  circuit HOUSE_ESSENTIAL {
    protection : rcbo { rating_a = 16A; curve = C; rcd_ma = 30mA; poles = 1; };
    essential  = yes;
    loads      = [FRIDGE, FREEZER, ROUTER];
  }
  circuit SEPTIC {
    protection : rcbo { rating_a = 20A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [SEPTIC_PUMP_1, SEPTIC_PUMP_2, SEPTIC_AERO];
  }
  circuit AC1_CKT {
    protection : rcbo { rating_a = 20A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [AC1];
  }
  circuit AC2_CKT {
    protection : rcbo { rating_a = 20A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [AC2];
  }
  circuit AC3_CKT {
    protection : rcbo { rating_a = 20A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [AC3];
  }
  circuit EV {
    protection : rcbo { rating_a = 32A; curve = C; rcd_ma = 30mA; poles = 1; };
    loads      = [EV_CHARGER];
  }
  circuit PV_FEED {
    protection : rcbo { rating_a = 20A; curve = C; rcd_ma = 30mA; poles = 1; };
  }
  circuit HW_FEED {
    protection : rcbo { rating_a = 32A; curve = C; rcd_ma = 30mA; poles = 1; };
    cable      = { csa = 6mm2; cores = 3; length = 15m; };
  }
  circuit RETIC_FEED {
    protection : rcbo { rating_a = 20A; curve = C; rcd_ma = 30mA; poles = 1; };
    cable      = { csa = 4mm2; cores = 3; length = 40m; };
  }
}

connect HOUSE_SUB.QS1.out -> HOUSE_SUB.bus;
connect INV1.ac_out -> HOUSE_SUB.PV_FEED.out;
connect PV1.out -> INV1.dc_in;
connect HOUSE_SUB.HW_FEED.out -> HW_SUB.in;
connect HOUSE_SUB.RETIC_FEED.out -> RETIC_SUB.in;

// ---------- HW Sub-board ----------
board HW_SUB : board {
  vs = LV;
  incomers = [HOUSE_SUB.HW_FEED.out];
  busbar_rating_a = 32A;
  ways = 4;

  main_switch QS2 : main_switch { rating_a = 32A; poles = 2; }

  circuit HW_BOOSTER {
    protection : mcb { rating_a = 20A; curve = C; };
    controller : contactor { rating_a = 25A; utilization = "AC-1"; coil_v = 230V; };
    loads      = [HW_BOOSTER_LOAD];
  }

  circuit HW_PUMP_CTRL {
    protection : mcb { rating_a = 10A; curve = C; };
    controller : control_relay { rating_a = 10A; coil_v = 230V; };
    loads      = [HW_PUMP];
  }
}

connect HW_SUB.QS2.out -> HW_SUB.bus;

// ---------- Retic Sub-board ----------
board RETIC_SUB : board {
  vs = LV;
  incomers = [HOUSE_SUB.RETIC_FEED.out];
  busbar_rating_a = 20A;
  ways = 4;

  main_switch QS3 : main_switch { rating_a = 20A; poles = 2; }

  circuit RETIC_MOTOR {
    protection : mcb { rating_a = 16A; curve = C; };
    controller : contactor { rating_a = 16A; utilization = "AC-3"; coil_v = 230V; };
    loads      = [M1];
  }
}

connect RETIC_SUB.QS3.out -> RETIC_SUB.bus;

// ---------- Loads ----------
// Shed load
SHED_MISC : appliance { kw = 2.0kW; on_time = 1h; period = 1d; }

// Intermittent low-A lighting circuits
LIGHTS_NTH_LOAD : lighting { kw = 1.2kW; points = 12; on_time = 4h; period = 1d; }
LIGHTS_STH_LOAD : lighting { kw = 1.0kW; points = 10; on_time = 4h; period = 1d; }
LIGHTS_EXT_LOAD : lighting { kw = 0.2kW; points = 4; on_time = 1h; period = 1d; }

// General socket circuits
SOCKETS_STH_LOAD : socket { kw = 2.4kW; points = 8; }
SOCKETS_NTH_LOAD : socket { kw = 3.3kW; points = 11; }
SOCKETS_KIT_LOAD : socket { kw = 2.7kW; points = 9; }
SOCKETS_FAN_LOAD : socket { kw = 1.0kW; points = 10; }

// Appliances (Intermittent)
WASHER : appliance { kw = 1.0kW; on_time = 1h; period = 1d; }
DRYER : appliance { kw = 2.0kW; on_time = 1h; period = 1d; }
DISHWASHER : appliance { kw = 1.5kW; on_time = 1h; period = 1d; }
STOVE : cooktop { kw = 7.0kW; phases = 1; }

// Continuous essential loads (no on_time/period profile implies continuous)
FRIDGE : appliance { kw = 0.2kW; }
FREEZER : appliance { kw = 0.3kW; }
ROUTER : appliance { kw = 0.01kW; }

// Intermittent motor/pumps
SEPTIC_PUMP_1 : appliance { kw = 1.0kW; on_time = 0.5h; period = 1d; }
SEPTIC_PUMP_2 : appliance { kw = 1.0kW; on_time = 0.5h; period = 1d; }
SEPTIC_AERO : appliance { kw = 0.1kW; on_time = 12h; period = 1d; }

// HVAC
AC1 : hvac { kw = 2.5kW; cop = 3.5; compressor = split; on_time = 4h; period = 1d; }
AC2 : hvac { kw = 2.5kW; cop = 3.5; compressor = split; on_time = 4h; period = 1d; }
AC3 : hvac { kw = 2.5kW; cop = 3.5; compressor = split; on_time = 4h; period = 1d; }

// EV Charger
EV_CHARGER : evse { kw = 7.0kW; phases = 1; mode = 2; v2x_capable = no; }

// HW Sub-board loads
HW_BOOSTER_LOAD : heating { kw = 3.6kW; on_time = 2h; period = 1d; }
HW_PUMP : motor { kw = 0.2kW; starter = none; duty = "S2"; on_time = 0.2h; period = 1h; }

// Retic Sub-board load
M1 : motor { kw = 1.1kW; starter = dol; duty = "S2"; on_time = 1h; period = 1d; }

// ---------- Operating States ----------
state "normal" {
  QF4 = closed;
  QS1 = closed;
  QS2 = closed;
  QS3 = closed;
}

state "grid_outage" {
  use "normal";
  QF4 = open;
  QS1 = open;
}

// ---------- Scenarios ----------
scenario "Loss of grid from normal" {
  use "grid_outage";
  set GRID.status = offline;
  set PV1.irradiance = 800W/m2;

  expect de_energized(SHED_MAIN.FU1.in);
  expect islanded(INV1);
  expect energized(HOUSE_SUB.HOUSE_ESSENTIAL);
}

// ---------- Layout Hints ----------
layout {
  rank = source_to_load;
  flow = top_to_bottom;
  SHED_MAIN  { column = 1; }
  HOUSE_SUB  { column = 2; }
  HW_SUB     { column = 3; row = 1; }
  RETIC_SUB  { column = 3; row = 2; }
}
