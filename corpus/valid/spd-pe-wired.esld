profile "esld/1.0";

// Spec §9.2: an SPD whose only explicit wiring is the PE/earth bond keeps
// its implicit busbar attachment at `in` — earth-role edges are not
// power-path connections.
voltsys LV = { nominal = 230V; phases = 1ph; frequency = 50Hz; };

grid GRID : grid { vs = LV; }

earth ROD : earth { electrode = "rod"; ohm = 10ohm; }

LAMP : lighting { kw = 0.1kW; points = 2; }

board MAIN : board {
  vs = LV;
  incomers = [GRID.out];
  busbar_rating_a = 100A;

  spd SPD1 : spd { spd_type = 2; in_ka = 10kA; }

  circuit LIGHTS {
    protection : rcbo { rating_a = 10A; curve = C; rcd_ma = 30mA; };
    loads = [LAMP];
  }
}

connect GRID.out -> MAIN.in;
connect MAIN.SPD1.pe -- ROD.e;
